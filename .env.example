# Настройки облака. Скопируй в .env и подставь свои значения.
#
# Project URL      — Supabase: Settings -> Data API
# Publishable key  — Supabase: Settings -> API Keys, вкладка
#                    "Publishable and secret API keys" (начинается на sb_publishable_)
#
# Эти значения попадают в собранный сайт и видны всем — так и задумано:
# publishable-ключ без входа ничего не открывает, доступ разрешает RLS
# (supabase/schema.sql). Ключ sb_secret_ сюда вставлять нельзя.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
